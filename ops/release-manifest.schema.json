{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio release media manifest",
  "type": "object",
  "required": ["schemaVersion", "release", "publishedCommit", "generatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "minLength": 1 },
    "publishedCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "objectKey",
          "sha256",
          "bytes",
          "durationSeconds",
          "resolution",
          "videoCodec",
          "pixelFormat",
          "colorSpace"
        ],
        "properties": {
          "slug": { "type": "string" },
          "objectKey": { "type": "string", "pattern": "-v[0-9]{2,}\\.mp4$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "resolution": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "videoCodec": { "type": "string" },
          "audioCodec": { "type": ["string", "null"] },
          "pixelFormat": { "type": "string" },
          "colorSpace": { "type": "string" }
        }
      }
    }
  }
}
